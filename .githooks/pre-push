#!/bin/sh
set -eu

remote_name=${1:-}
remote_url=${2:-}
normalized_url=$(printf '%s' "$remote_url" | tr '[:upper:]' '[:lower:]')

case "$remote_name" in
  upstream)
    echo "Blocked: upstream is read-only. Pushing to MBrekhof/xafskills is forbidden." >&2
    exit 1
    ;;
esac

case "$normalized_url" in
  *github.com/mbrekhof/xafskills|*github.com/mbrekhof/xafskills.git|*github.com:mbrekhof/xafskills|*github.com:mbrekhof/xafskills.git)
    echo "Blocked: pushing to MBrekhof/xafskills is forbidden." >&2
    exit 1
    ;;
esac
